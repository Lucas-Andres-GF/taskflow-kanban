---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'TaskFlow' } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="TaskFlow, tablero personal para organizar tareas" />
    <meta name="theme-color" content="#F7F6F3" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="TaskFlow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen overflow-x-hidden">
    <header class="sticky top-0 z-20 border-b border-line bg-paper/90 backdrop-blur-md">
      <div class="mx-auto flex max-w-[1500px] items-center justify-between gap-3 px-4 py-3 sm:px-8 sm:py-4 lg:px-10">
        <a href="/" class="flex items-center gap-3 text-ink" aria-label="TaskFlow inicio">
          <span class="grid h-8 w-8 place-items-center border border-ink bg-paper-card sm:h-9 sm:w-9">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="1.8" d="M7 7h10M7 12h10M7 17h6" />
            </svg>
          </span>
          <span>
            <span class="block text-xs font-semibold uppercase tracking-[0.22em] sm:text-sm sm:tracking-[0.24em]">TaskFlow</span>
            <span class="hidden text-xs text-ink-muted sm:block">Orden diario sin ruido visual</span>
          </span>
        </a>

        <div class="flex items-center gap-2 sm:gap-3">
          <div class="hidden border border-line bg-paper-card px-3 py-2 text-right sm:block">
            <p class="font-mono text-[9px] uppercase tracking-[0.2em] text-ink-muted">Estado</p>
            <p id="taskCount" class="font-serif text-xl leading-none tracking-tight text-ink">Cargando</p>
          </div>

          <button id="refreshBtn" type="button" class="hidden border border-line bg-paper-card px-3 py-2 text-sm text-ink-muted transition-colors hover:bg-paper-muted hover:text-ink md:block">
            Actualizar
          </button>

          <button id="addTaskBtn" class="btn-primary flex items-center gap-2 px-3 sm:px-4" type="button" title="Nueva tarea (Ctrl+Alt+N)" aria-label="Nueva tarea">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="1.8" d="M12 5v14M5 12h14" />
            </svg>
            <span class="hidden sm:inline">Nueva tarea</span>
          </button>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-[1500px] px-4 py-6 sm:px-8 sm:py-10 lg:px-10 lg:py-14">
      <slot />
    </main>

    <div id="addTaskModal" class="hidden fixed inset-0 z-50 items-center justify-center overflow-y-auto bg-ink/20 p-4 backdrop-blur-sm sm:p-5">
      <div class="max-h-[calc(100vh-2rem)] w-full max-w-lg overflow-y-auto border border-line bg-paper-card p-5 sm:p-8">
        <div class="mb-8 flex items-start justify-between gap-6 border-b border-line pb-6">
          <div>
            <p class="mb-2 font-mono text-xs uppercase tracking-[0.24em] text-ink-muted">Nueva entrada</p>
            <h2 class="font-serif text-3xl leading-none tracking-tight text-ink">Crear tarea</h2>
          </div>
          <button id="cancelAddTask" type="button" class="border border-line px-3 py-2 text-sm text-ink-muted transition-colors hover:bg-paper-muted hover:text-ink">
            Cerrar
          </button>
        </div>

        <form id="addTaskForm" class="space-y-5">
          <div>
            <label class="mb-2 block text-xs font-semibold uppercase tracking-[0.2em] text-ink-muted">Titulo</label>
            <input
              type="text"
              name="title"
              id="taskTitleInput"
              required
              class="field"
              placeholder="Ej. Revisar tareas de la semana"
            />
          </div>

          <div>
            <label class="mb-2 block text-xs font-semibold uppercase tracking-[0.2em] text-ink-muted">Descripcion</label>
            <textarea
              name="description"
              rows="4"
              class="field resize-none"
              placeholder="Notas concretas para cuando vuelvas a esta tarea"
            ></textarea>
          </div>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label class="mb-2 block text-xs font-semibold uppercase tracking-[0.2em] text-ink-muted">Prioridad</label>
              <select name="priority" class="field">
                <option value="low">Baja</option>
                <option value="medium" selected>Media</option>
                <option value="high">Alta</option>
              </select>
            </div>
            <div>
              <label class="mb-2 block text-xs font-semibold uppercase tracking-[0.2em] text-ink-muted">Fecha limite</label>
              <input type="date" name="due_date" class="field" />
            </div>
          </div>

          <div class="flex justify-end gap-3 border-t border-line pt-5">
            <button type="button" id="cancelAddTaskSecondary" class="btn-secondary">Cancelar</button>
            <button type="submit" class="btn-primary">Crear tarea</button>
          </div>
        </form>
      </div>
    </div>
  </body>
</html>
