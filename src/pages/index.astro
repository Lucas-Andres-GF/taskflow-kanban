---
import Layout from '../layouts/Layout.astro';
import KanbanBoard from '../components/KanbanBoard.jsx';
---

<Layout title="TaskFlow - Personal OS">
  <KanbanBoard client:load />

  <script>
    window.addEventListener('taskCountUpdate', (e) => {
      const countEl = document.getElementById('taskCount');
      if (countEl) countEl.textContent = `${e.detail} tareas`;
    });

    document.getElementById('refreshBtn')?.addEventListener('click', () => {
      window.location.reload();
    });

    const modal = document.getElementById('addTaskModal');
    const addBtn = document.getElementById('addTaskBtn');
    const cancelBtn = document.getElementById('cancelAddTask');
    const cancelSecondaryBtn = document.getElementById('cancelAddTaskSecondary');
    const form = document.getElementById('addTaskForm') as HTMLFormElement | null;
    const titleInput = document.getElementById('taskTitleInput') as HTMLInputElement | null;

    const closeModal = () => {
      modal?.classList.add('hidden');
      addBtn?.focus();
    };
    const openModal = () => {
      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
      requestAnimationFrame(() => titleInput?.focus());
    };

    addBtn?.addEventListener('click', openModal);

    window.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement | null;
      const isTyping = target?.matches('input, textarea, select, [contenteditable="true"]');

      if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
        e.preventDefault();
        closeModal();
        return;
      }

      if (isTyping) return;
      if (e.ctrlKey && e.altKey && e.key.toLowerCase() === 'n') {
        e.preventDefault();
        openModal();
      }
    });

    cancelBtn?.addEventListener('click', closeModal);
    cancelSecondaryBtn?.addEventListener('click', closeModal);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const taskData = {
        title: formData.get('title'),
        description: formData.get('description') || '',
        priority: formData.get('priority'),
        due_date: formData.get('due_date') || null,
        status: 'todo',
      };

      try {
        const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || 'https://your-project.supabase.co';
        const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || 'your-anon-key';
        const { createClient } = await import('@supabase/supabase-js');
        const supabase = createClient(supabaseUrl, supabaseAnonKey);

        const { data, error } = await supabase
          .from('tasks')
          .insert([taskData])
          .select()
          .single();

        if (error) throw error;

        closeModal();
        form.reset();
        window.dispatchEvent(new CustomEvent('taskCreated', { detail: data }));
      } catch (err) {
        const message = err instanceof Error ? err.message : 'No se pudo crear la tarea';
        console.error('Error creating task:', err);
        window.dispatchEvent(new CustomEvent('taskCreateError', { detail: message }));
      }
    });
  </script>
</Layout>
